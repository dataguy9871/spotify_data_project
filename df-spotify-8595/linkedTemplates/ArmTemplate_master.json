{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-spotify-8595"
		},
		"ls_source_spotify_sql_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_source_spotify_sql_db'"
		},
		"ls_target_adls_gen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_target_adls_gen2'"
		},
		"ls_source_spotify_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifydataprojectshubham.database.windows.net"
		},
		"ls_source_spotify_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotify_data_project"
		},
		"ls_source_spotify_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "spotifydataproject"
		},
		"ls_target_adls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifydata9927.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-spotify-8595_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_source_spotify_sql_db_password": {
						"value": "[parameters('ls_source_spotify_sql_db_password')]"
					},
					"ls_target_adls_gen2_accountKey": {
						"value": "[parameters('ls_target_adls_gen2_accountKey')]"
					},
					"ls_source_spotify_sql_db_properties_typeProperties_server": {
						"value": "[parameters('ls_source_spotify_sql_db_properties_typeProperties_server')]"
					},
					"ls_source_spotify_sql_db_properties_typeProperties_database": {
						"value": "[parameters('ls_source_spotify_sql_db_properties_typeProperties_database')]"
					},
					"ls_source_spotify_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_source_spotify_sql_db_properties_typeProperties_userName')]"
					},
					"ls_target_adls_gen2_properties_typeProperties_url": {
						"value": "[parameters('ls_target_adls_gen2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}